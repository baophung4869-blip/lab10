@startuml
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam ArrowColor #27476E
skinparam ClassBorderColor #315477
skinparam ClassBackgroundColor #F8FAFC
left to right direction
interface IDevice {
 +Name: string
 +IsOn: bool
 +TurnOn(): void
 +TurnOff(): void
}
interface ILockable {
 +IsLocked: bool
 +Lock(): void
 +Unlock(): void
}
class SmartLight
class SmartFan
class SmartDoor
class DeviceFactory <<Factory>> {
 +Create(type: string, name: string): IDevice
}
class HomeConfiguration <<Singleton>> {
 -HomeConfiguration()
 +Instance: HomeConfiguration
 +HomeName: string
 +NightLightLevel: int
}
class SmartHomeFacade <<Facade>> {
 -light: IDevice
 -fan: IDevice
 -door: ILockable
 +GoToWork(): void
 +GoToSleep(): void
}
class Program
class LabTests
IDevice <|.. SmartLight
IDevice <|.. SmartFan
IDevice <|.. SmartDoor
ILockable <|.. SmartDoor
DeviceFactory ..> IDevice : creates
SmartHomeFacade --> IDevice : light / fan
SmartHomeFacade --> ILockable : door
SmartHomeFacade ..> HomeConfiguration : reads
Program ..> DeviceFactory
Program ..> SmartHomeFacade
LabTests ..> DeviceFactory
LabTests ..> HomeConfiguration
LabTests ..> SmartHomeFacade
@enduml
